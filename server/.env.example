DATABASE_URL="file:./dev.db"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
PORT=3001

# Asistente conversacional (opcional): sin esto, /asistente/chat responde
# 503 en vez de romper. Conseguir una key en console.anthropic.com.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# Import de recetas por búsqueda web (opcional): sin esto, /recetas/buscar-web
# responde 503. Conseguir una key gratis en api-dashboard.search.brave.com.
BRAVE_API_KEY=""

# Recuperar contraseña e invitación de miembros por email (opcional): sin
# esto, /auth/recuperar/solicitar responde 503, y la invitación de un
# miembro devuelve el código en la respuesta en vez de mandarlo por mail.
# Conseguir una key gratis en resend.com. MAIL_FROM requiere un dominio
# verificado en Resend; sin eso, dejar el remitente de prueba por defecto.
RESEND_API_KEY=""
MAIL_FROM="CocinaInteligente <onboarding@resend.dev>"
